pkgname=lightswitch
pkgver=0.1.0
pkgrel=1
pkgdesc='Dump a thought in a second, then get back to work'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lightswitch "$pkgdir/usr/bin/lightswitch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lightswitch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lightswitch.svg"
  install -Dm644 "$startdir/lightswitch.desktop" "$pkgdir/usr/share/applications/lightswitch.desktop"
}
